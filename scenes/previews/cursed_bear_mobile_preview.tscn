[ext_resource type="PackedScene" path="res://assets/characters/cursed_bear/cursed_bear_mobile.glb" id="2"]

[sub_resource type="GDScript" id="Controls"]
script/source = "extends Node3D

func _ready() -> void:
	for button in $Views/Row.get_children():
		var camera: Camera3D = get_node(str(button.name))
		camera.look_at(Vector3(0, 0.34, 0))
		button.pressed.connect(camera.make_current)
	$Views/Options/Cave.toggled.connect(set_cave)
	$Views/Options/Original.toggled.connect(set_original)

func set_cave(enabled: bool) -> void:
	$Environment.environment.ambient_light_energy = 0.19 if enabled else 0.85
	$Key.light_energy = 0.39 if enabled else 1.15
	$Key.light_color = Color(0.72, 0.82, 1.0) if enabled else Color.WHITE
	$Fill.light_energy = 0.14 if enabled else 0.6
	$Environment.environment.background_color = Color(0.035, 0.04, 0.06) if enabled else Color(0.23, 0.24, 0.25)

func set_original(enabled: bool) -> void:
	$Bear.visible = not enabled
	$Original.visible = enabled
"

