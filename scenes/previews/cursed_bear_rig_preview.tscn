[gd_scene format=3]

[ext_resource type="PackedScene" path="res://assets/characters/cursed_bear/cursed_bear_rigged.glb" id="1"]

[sub_resource type="GDScript" id="Controls"]
script/source = "extends Node3D

@onready var skeleton: Skeleton3D = $Bear.find_children(\"*\", \"Skeleton3D\", true, false)[0]

func _ready() -> void:
	for button in $Views/Row.get_children():
		var camera: Camera3D = get_node(str(button.name))
		camera.look_at(Vector3(0, 0.34, 0))
		button.pressed.connect(camera.make_current)
	for button in $Views/Poses.get_children():
		button.pressed.connect(set_pose.bind(str(button.name)))

func bend(bone: String, axis: Vector3, degrees: float) -> void:
	var id := skeleton.find_bone(bone)
	var rest := skeleton.get_bone_global_rest(id).basis.orthonormalized()
	var local_axis := (rest.inverse() * axis).normalized()
	var rotation := skeleton.get_bone_rest(id).basis.get_rotation_quaternion()
	skeleton.set_bone_pose_rotation(id, rotation * Quaternion(local_axis, deg_to_rad(degrees)))

func set_pose(pose: String) -> void:
	skeleton.reset_bone_poses()
	match pose:
		\"Foreleg\":
			bend(\"Shoulder.R\", Vector3.BACK, 9)
			bend(\"UpperFore.R\", Vector3.BACK, 23)
			bend(\"Forearm.R\", Vector3.BACK, -31)
			bend(\"ForePaw.R\", Vector3.BACK, 12)
		\"Hindleg\":
			bend(\"Hip.R\", Vector3.BACK, 6)
			bend(\"Thigh.R\", Vector3.BACK, 22)
			bend(\"Shin.R\", Vector3.BACK, -32)
			bend(\"Hock.R\", Vector3.BACK, 14)
		\"Neck\":
			bend(\"Neck\", Vector3.UP, -12)
			bend(\"Head\", Vector3.BACK, 9)
		\"Jaw\":
			bend(\"Jaw\", Vector3.BACK, -19)
"

