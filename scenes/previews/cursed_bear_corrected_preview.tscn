[gd_scene format=3]

[ext_resource type="PackedScene" path="res://assets/characters/cursed_bear/cursed_bear_corrected.glb" id="1"]

[sub_resource type="GDScript" id="Controls"]
script/source = "extends Node3D

@onready var player: AnimationPlayer = $Bear.find_children(\"*\", \"AnimationPlayer\", true, false)[0]
@onready var selector: OptionButton = $Views/Playback/Clip

func _ready() -> void:
	for view in $Views/Row.get_children():
		var camera: Camera3D = get_node(str(view.name))
		camera.look_at(Vector3(0, 0.34, 0))
		view.pressed.connect(camera.make_current)
	for clip in player.get_animation_list():
		if clip != \"RESET\":
			selector.add_item(clip)
			if clip == \"Walk_Loop\":
				selector.select(selector.item_count - 1)
	selector.item_selected.connect(play_clip)
	$Views/Playback/Replay.pressed.connect(func(): play_clip(selector.selected))
	play_clip(selector.selected)

func play_clip(index: int) -> void:
	player.stop()
	player.play(selector.get_item_text(index))
	player.advance(0)"

