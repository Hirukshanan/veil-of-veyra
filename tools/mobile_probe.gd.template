extends Node
# Test build only. Engine frame intervals are not GPU or display-present timings.
var game:Node
var last_us:=0
var frames:Array[String]=[]
var elapsed:=0.0
var samples:FileAccess
var counters:FileAccess
var session:String
func _ready():
	process_mode=Node.PROCESS_MODE_ALWAYS
	session="mobile_profile_"+str(int(Time.get_unix_time_from_system()))
	DirAccess.make_dir_recursive_absolute("user://"+session)
	samples=FileAccess.open("user://"+session+"/frames.csv",FileAccess.WRITE)
	counters=FileAccess.open("user://"+session+"/counters.csv",FileAccess.WRITE)
	samples.store_line("monotonic_us,interval_us,active_gameplay")
	counters.store_line("monotonic_us,x,y,z,draw_calls,primitives,static_bytes,video_bytes,texture_bytes,frame_limit,shadows,paused")
	var f:=FileAccess.open("user://"+session+"/session.json",FileAccess.WRITE)
	f.store_string(JSON.stringify({"schema":1,"started_utc":Time.get_datetime_string_from_system(true),"platform":OS.get_name(),"renderer":RenderingServer.get_current_rendering_method(),"model":OS.get_model_name(),"viewport":str(get_viewport().get_visible_rect().size),"note":"Local test-build engine intervals; foreground gameplay filter required. No GPU time, thermal or battery measurement in this file. Periodic CSV flush can add small observer overhead."},"  "))
	last_us=Time.get_ticks_usec()
func _process(delta):
	var now:=Time.get_ticks_usec();var active:bool=game.started and not get_tree().paused and not game.game_finished
	frames.append(str(now)+","+str(now-last_us)+","+str(int(active)));last_us=now;elapsed+=delta
	if elapsed<5:return
	elapsed=0
	samples.store_string("\n".join(frames)+"\n");frames.clear();samples.flush()
	var p:Vector3=game.player.global_position
	counters.store_line("%d,%.3f,%.3f,%.3f,%d,%d,%d,%d,%d,%d,%d,%d"%[now,p.x,p.y,p.z,Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME),Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME),Performance.get_monitor(Performance.MEMORY_STATIC),Performance.get_monitor(Performance.RENDER_VIDEO_MEM_USED),Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED),game.frame_limit,int(game.shadows_enabled),int(get_tree().paused)])
	counters.flush()
func _notification(what):
	if what==NOTIFICATION_APPLICATION_PAUSED or what==NOTIFICATION_WM_CLOSE_REQUEST:
		if samples!=null and not frames.is_empty():samples.store_string("\n".join(frames)+"\n");frames.clear();samples.flush()
