extends RefCounted

# Candidate-only physical corrections. Materials, UVs, topology and X/Z are retained.
static func fit_region(visual:MeshInstance3D,region:String,surface:Resource)->void:
	var graded:bool=str(visual.name).contains("GradedTerrain")
	if not graded and region!="WaterfallMountains":return
	var mesh:=ArrayMesh.new()
	for index in range(visual.mesh.get_surface_count()):
		var arrays:Array=visual.mesh.surface_get_arrays(index)
		var vertices:PackedVector3Array=arrays[Mesh.ARRAY_VERTEX]
		for i in vertices.size():
			var point:Vector3=visual.global_transform*vertices[i]
			if graded:point.y=surface.sample(Vector2(point.x,point.z))
			else:
				point.y=surface.feature_height(point)

			vertices[i]=visual.global_transform.affine_inverse()*point
		arrays[Mesh.ARRAY_VERTEX]=vertices
		if not graded:
			# Remove the obsolete rock faces in the widened bank corridor. The existing
			# shared GradedTerrain beneath owns this ground; collapsed rock triangles
			# would produce spikes and duplicate collision surfaces instead.
			var indices:PackedInt32Array=arrays[Mesh.ARRAY_INDEX]
			var kept:=PackedInt32Array()
			for face in range(0,indices.size(),3):
				var remove:=false
				for corner in range(3):
					var p:Vector3=visual.global_transform*vertices[indices[face+corner]]
					if p.z > -66 and p.z < -34 and absf(p.x-surface.river_center(p.z))<surface.river_width(p.z)+24:remove=true
				if not remove:kept.append_array(indices.slice(face,face+3))
			arrays[Mesh.ARRAY_INDEX]=kept
		mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays)
	var tool:=SurfaceTool.new();tool.create_from(mesh,0);tool.generate_normals()
	visual.mesh=tool.commit()
	# Mountain/cave LODs are regenerated by the existing Task 3 normal pass.
	# Retain distance LODs for the other fitted regional patches as well.
	if region in ["RiverGrassland","SouthernBeach"]:
		var importer:=ImporterMesh.new()
		importer.add_surface(Mesh.PRIMITIVE_TRIANGLES,visual.mesh.surface_get_arrays(0))
		importer.generate_lods(60.0,25.0,[])
		visual.mesh=importer.get_mesh()

static func tree_collisions(landscape:Node3D,transforms:Array[Transform3D])->void:
	var body:=StaticBody3D.new();body.name="MatureTreeTrunks"
	body.collision_layer=1|4|8;body.collision_mask=0;landscape.add_child(body)
	for index in transforms.size():
		var t:Transform3D=transforms[index]
		var shape:=CylinderShape3D.new()
		shape.radius=.32*maxf(t.basis.x.length(),t.basis.z.length())
		shape.height=2.7*t.basis.y.length()
		var collider:=CollisionShape3D.new();collider.name="Trunk%02d"%index;collider.shape=shape
		collider.position=t.origin+Vector3.UP*(shape.height*.5-.04)
		body.add_child(collider)
